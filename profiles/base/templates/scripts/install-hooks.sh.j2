#!/usr/bin/env bash
# install-hooks.sh — Ensure pre-commit hooks are active in this repo.
# Run once after clone, or after any CI/agent setup.
# Safe to re-run — idempotent.

set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${PROJECT_ROOT}/venv"

echo "=== Installing pre-commit hooks ==="

# Create venv if missing
if [[ ! -d "${VENV}" ]]; then
    echo "Creating venv..."
    python3 -m venv "${VENV}"
fi

# Install requirements-dev if present
if [[ -f "${PROJECT_ROOT}/requirements-dev.txt" ]]; then
    "${VENV}/bin/pip" install -r "${PROJECT_ROOT}/requirements-dev.txt" --quiet
fi

# Ensure pre-commit is available
if [[ ! -x "${VENV}/bin/pre-commit" ]]; then
    echo "Installing pre-commit into venv..."
    "${VENV}/bin/pip" install pre-commit --quiet
fi

# Install the hooks into .git/hooks/
cd "${PROJECT_ROOT}"
"${VENV}/bin/pre-commit" install --install-hooks

echo "✅ pre-commit hooks installed and ready."
